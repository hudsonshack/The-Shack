#!/bin/sh
# J.A.R.V.I.S. Ops: push state commits automatically.
# Only on the state branch. Set JARVIS_AUTOPUSH=0 to turn it off for one commit.
[ "${JARVIS_AUTOPUSH:-1}" = "0" ] && exit 0
ROOT=$(git rev-parse --show-toplevel) || exit 0
BRANCH=$(git rev-parse --abbrev-ref HEAD)
STATE_BRANCH=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['state_branch'])" "$ROOT/jarvis-ops/config.json" 2>/dev/null || echo "ops/state")
[ "$BRANCH" = "$STATE_BRANCH" ] || exit 0
mkdir -p "$ROOT/jarvis-ops/private"
( git push -q -u origin "$BRANCH" >>"$ROOT/jarvis-ops/private/autopush.log" 2>&1 & )
echo "post-commit: pushing $BRANCH in the background (log: jarvis-ops/private/autopush.log)"
