#!/bin/sh
# J.A.R.V.I.S. Ops: validate state, block secrets, re-render the dashboard.
ROOT=$(git rev-parse --show-toplevel) || exit 1
git diff --cached --name-only | grep -q '^jarvis-ops/' || exit 0
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 not found, skipping J.A.R.V.I.S. Ops checks" >&2; exit 0; }
python3 "$ROOT/jarvis-ops/scripts/validate.py" --staged || exit 1
python3 "$ROOT/jarvis-ops/scripts/render_dashboard.py" >/dev/null || exit 1
git add "$ROOT/jarvis-ops/dashboard/DASHBOARD.md" "$ROOT/jarvis-ops/dashboard/dashboard.html"
